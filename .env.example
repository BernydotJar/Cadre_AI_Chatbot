# Cadre AI Chatbot — environment template. Copy to .env.local and fill values.
# All variables are SERVER-SIDE ONLY. Never commit real values.

# Chat provider: "mock" runs fully local simulated responses (clearly labeled in the UI).
# A live provider value will be documented once the provider decision (U1) is made.
CHAT_PROVIDER=mock

# Server-side API key for the live provider. Placeholder name until U1 resolves.
# CHAT_PROVIDER_API_KEY=
