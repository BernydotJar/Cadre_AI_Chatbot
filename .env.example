# Cadre AI Chatbot — environment template. Copy to .env.local and fill values.
# All variables are SERVER-SIDE ONLY. Never commit real values.

# Chat provider: "mock" runs fully local simulated responses (clearly labeled in the UI).
# "openrouter" enables the approved, extractive live model. Unknown modes fail closed.
CHAT_PROVIDER=mock

# Live mode requires all three. No credentials are needed for mock mode.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4.1-mini
# Owner-authorized operational deadline, never later than this date.
# OPENROUTER_KEY_EXPIRES_AT=2026-09-15T00:00:00Z

# Optional: x-real-ip or x-forwarded-for, only when a verified trusted ingress
# strips client-supplied values and sets a single IP. Otherwise leave unset.
# Unset, invalid, absent or ambiguous IP metadata shares one global limit.
# State is process-local: 10 requests/minute, <=1024 client windows + overflow;
# not shared across instances and reset on restart. This is best-effort abuse control.
# CHAT_TRUSTED_PROXY_IP_HEADER=
