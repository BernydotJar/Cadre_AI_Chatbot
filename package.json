{
  "name": "cadre-ai-chatbot",
  "version": "0.1.0",
  "private": true,
  "description": "Grounded customer-support chatbot for Cadre AI.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "release:gate": "node tools/release/check-premium-gate.mjs",
    "graph:generate": "node tools/graph-adapter/generate.mjs",
    "graph": "node tools/graph-adapter/graph.mjs",
    "verify": "node tools/graph-adapter/verify.mjs"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
