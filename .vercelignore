# Deny by default. Only application/build inputs go to the hosting service.
/*
!/app
!/src
!/public
!/package.json
!/package-lock.json
!/next.config.ts
!/tsconfig.json
!/vercel.json
/src/config/fixtures
# Defense in depth for private files nested in an allowed directory.
**/.codex/**
**/.git/**
**/.env*
# The tracked placeholder file is safe and is required by Next/Vercel file tracing.
!/.env.example
**/*.pem
**/*.key
**/*.zip
**/.DS_Store
